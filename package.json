{
  "name": "power-pages-as-code",
  "version": "0.0.1",
  "private": true,
  "workspaces": ["src/frontend"],
  "scripts": {
    "dev": "npm run dev --workspace @powerpages-as-code/frontend",
    "build": "npm run version:check && npm run contracts:validate && npm run backend:sync && npm run build --workspace @powerpages-as-code/frontend",
    "typecheck": "npm run typecheck --workspace @powerpages-as-code/frontend",
    "lint": "npm run lint --workspace @powerpages-as-code/frontend",
    "backend:sync": "node scripts/sync-server-logic.mjs",
    "backend:validate": "node scripts/validate-server-logic.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "doctor": "node scripts/doctor.mjs",
    "security:audit": "npm audit --audit-level=high",
    "version:check": "node scripts/check-version.mjs",
    "version:print": "node scripts/read-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "check": "npm run version:check && npm run contracts:validate && npm run lint && npm run typecheck && npm run backend:sync && npm run backend:validate",
    "test": "npm run test --workspace @powerpages-as-code/frontend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "engines": { "node": ">=22" }
}
