{
  "name": "power-pages-as-code",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "npm run dev --workspace ./src/frontend",
    "build": "npm run version:check && npm run brand:check && npm run contracts:validate && npm run backend:validate && npm run build:backend && npm run build:frontend && npm run build:package",
    "build:frontend": "npm run build --workspace ./src/frontend",
    "build:backend": "node scripts/build-server-logic.mjs",
    "build:package": "node scripts/package-powerpages.mjs",
    "typecheck": "npm run typecheck --workspace ./src/frontend",
    "lint": "npm run lint --workspace ./src/frontend",
    "backend:validate": "node scripts/validate-server-logic.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "rebrand": "node scripts/rebrand.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "doctor": "node scripts/doctor.mjs",
    "security:audit": "npm audit --audit-level=high",
    "version:check": "node scripts/check-version.mjs",
    "version:print": "node scripts/read-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "check": "npm run version:check && npm run brand:check && npm run contracts:validate && npm run lint && npm run typecheck && npm run backend:validate",
    "test": "npm run test --workspace ./src/frontend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}
