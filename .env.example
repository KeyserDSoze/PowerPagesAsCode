# Local/browser configuration only. Never place secrets here.
# Production deployment identity values belong in GitHub Environments.

E2E_BASE_URL=

# Optional frontend runtime/build configuration.
VITE_APP_ENVIRONMENT=local
VITE_SYNC_PUSH_BATCH_SIZE=20
VITE_SYNC_PULL_PAGE_SIZE=50
VITE_SYNC_PULL_MAX_PAGES=10
VITE_SYNC_MAX_ATTEMPTS=6
VITE_SYNC_RETRY_BASE_MS=2000
VITE_SYNC_RETRY_MAX_MS=300000
VITE_CACHE_RETENTION_DAYS=30
VITE_VERSION_CHECK_INTERVAL_MS=60000
VITE_DIAGNOSTICS_ENABLED=true
VITE_DIAGNOSTICS_MAX_LOGS=100
