{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerpagesascode.local/contracts/field-service-sync.request.schema.json",
  "title": "Field Service sync request",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "operation", "recordId", "payload"],
        "properties": {
          "operationId": { "type": "string", "format": "uuid" },
          "operation": { "const": "submitWorkOrderExecution" },
          "recordId": { "type": "string", "format": "uuid" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workOrderId", "status", "technicianNote", "followUpRequired"],
            "properties": {
              "workOrderId": { "type": "string", "format": "uuid" },
              "status": { "enum": ["inProgress", "completed"] },
              "technicianNote": { "type": "string", "maxLength": 8000 },
              "followUpRequired": { "type": "boolean" },
              "arrivedOn": { "type": "string", "format": "date-time" },
              "completedOn": { "type": "string", "format": "date-time" },
              "baseModifiedOn": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
